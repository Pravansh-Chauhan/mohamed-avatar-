generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GenerationStatus {
  SUCCESS
  FAILED
}

enum AudioFormat {
  WAV
  MP3
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  role           Role             @default(USER)
  creditsBalance Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  generations    VoiceGeneration[]
  ledgerEntries  CreditLedger[]
  subscriptions  Subscription[]
}

model Voice {
  id          String            @id @default(cuid())
  name        String
  gender      String
  style       String
  locale      String            @default("ar-MA")
  previewText String
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  generations VoiceGeneration[]
}

model VoiceGeneration {
  id                   String           @id @default(cuid())
  userId               String
  voiceId              String
  scriptText           String
  tone                 String
  dialect              String
  charCount            Int
  estimatedDurationSec Int
  estimatedCostCredits Int
  status               GenerationStatus
  providerName         String
  format               AudioFormat
  storagePath          String
  fileSizeBytes        Int
  checksum             String
  createdAt            DateTime         @default(now())
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  voice                Voice            @relation(fields: [voiceId], references: [id])
  ledgerEntries        CreditLedger[]
}

model CreditLedger {
  id           String           @id @default(cuid())
  userId       String
  generationId String?
  amount       Int
  reason       String
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation   VoiceGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)
}

model Plan {
  id             String         @id @default(cuid())
  code           String         @unique
  name           String
  monthlyCredits Int
  priceMad       Int
  isActive       Boolean        @default(true)
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
}

model Subscription {
  id                 String   @id @default(cuid())
  userId             String
  planId             String
  provider           String
  providerCustomerId String?
  providerSubId      String?
  status             String
  renewsAt           DateTime?
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan     @relation(fields: [planId], references: [id])
}

model BackgroundTrack {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  path      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}
